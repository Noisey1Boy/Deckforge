generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Deck {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  themeId     String
  slidesJson  String
  outlineJson String?
  metaJson    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// HTML template-mode decks: AI-filled template decks + from-scratch JS-library decks
model HtmlDeck {
  id          String   @id @default(cuid())
  title       String
  subtitle    String   @default("")
  templateId  String   @default("")
  engine      String   @default("opendesign")
  html        String
  outlineJson String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
