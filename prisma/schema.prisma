generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  decks        Deck[]
  htmlDecks    HtmlDeck[]
  sessions     Session[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Deck {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  themeId     String
  slidesJson  String
  outlineJson String?
  metaJson    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// HTML template-mode decks: AI-filled template decks + from-scratch JS-library decks
model HtmlDeck {
  id          String   @id @default(cuid())
  title       String
  subtitle    String   @default("")
  templateId  String   @default("")
  engine      String   @default("opendesign")
  html        String
  outlineJson String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
